# ── DR DOOM environment configuration ──────────────────────────────────────
# Copy this file to backend/.env for local development, or set these as
# environment variables in your Render service dashboard.

# --- Database -----------------------------------------------------------
# Postgres in production (Render Postgres). Falls back to a local SQLite
# file automatically when unset, for local development only — see
# README.md "Render Free storage constraint" for why SQLite/local files are
# NOT suitable for persistent deployment.
DATABASE_URL=postgresql+psycopg2://drdoom:drdoom@localhost:5432/drdoom

# --- Security -------------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# In production (Render), the frontend Static Site and backend Web Service
# live on different subdomains — browsers treat that as cross-site, so the
# session cookie needs COOKIE_SAMESITE=none, which in turn requires
# COOKIE_SECURE=true (Render terminates HTTPS for you). For local dev with
# the Vite proxy (frontend/vite.config.ts), leave both as shown below.
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# --- CORS -------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173

# --- Model layer (see backend/app/core/model_registry.py) -----------------
# template            = deterministic evidence-composed responses (default,
#                        zero extra RAM, always works — recommended for
#                        Render Free)
# local_transformers   = small local HF instruct model (needs requirements-full.txt)
# ollama                = call a locally-running Ollama server
MODEL_PROVIDER=template
MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
MODEL_QUANTIZATION=none
MODEL_MAX_TOKENS=512
MODEL_TEMPERATURE=0.2
OLLAMA_BASE_URL=http://localhost:11434

# --- Embeddings / retrieval -------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VECTOR_INDEX_PATH=knowledge_base/index
HYBRID_SEMANTIC_WEIGHT=0.70
HYBRID_KEYWORD_WEIGHT=0.30
RETRIEVAL_TOP_K=6
GROUNDING_MIN_SIMILARITY=0.42

KNOWLEDGE_VERSION=2026.08.1

# --- Feature flags -------------------------------------------------------
ENABLE_VOICE=true
ENABLE_TTS=true
ENABLE_SERVER_TRANSCRIBE=false

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_VOICE=15/minute
