# Copy to frontend/.env for local dev, or set in Render Static Site env vars.

# Local development (recommended): leave VITE_API_URL empty so requests go
# through the Vite dev-server proxy defined in vite.config.ts — this keeps
# the frontend and backend same-origin during dev, which avoids needing
# cross-site cookie settings. Point VITE_PROXY_TARGET at wherever your
# backend is actually running.
VITE_API_URL=
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Production (Render Static Site env var): point directly at the deployed
# backend Web Service URL. This is a genuinely cross-origin call, so the
# backend must be configured with COOKIE_SAMESITE=none and
# COOKIE_SECURE=true (see backend/.env.example) for the session cookie to
# work.
# VITE_API_URL=https://dr-doom-backend.onrender.com
